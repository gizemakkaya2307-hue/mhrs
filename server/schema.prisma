generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  tcNo      String   @unique
  role      String   @default("USER") // USER, DOCTOR, ADMIN
  createdAt DateTime @default(now())
  
  is2FAEnabled Boolean @default(false)
  twoFACode    String?
  
  updatedAt DateTime @updatedAt
  penaltyUntil DateTime? // Penalty period
  
  appointments Appointment[]
  reviews      Review[]
  logs         Log[]
  waitingList  WaitingList[]
  dependents   Dependent[]   @relation("UserToDependents")
  favorites    FavoriteDoctor[]
  notifications Notification[]
  healthProfile HealthProfile?
  auditLogs     AuditLog[]
  appointmentDrafts AppointmentDraft[]
  doctorProfile  Doctor?
}

model FavoriteDoctor {
  id        Int      @id @default(autoincrement())
  userId    Int
  doctorId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, doctorId])
}

model Dependent {
  id        Int      @id @default(autoincrement())
  name      String
  tcNo      String   @unique
  birthDate DateTime
  relation  String   // Child, Parent, etc.
  userId    Int
  user      User     @relation("UserToDependents", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  appointments Appointment[]
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  branch    String
  hospital  String
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinicId  Int?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  
  appointments Appointment[]
  timeSlots    TimeSlot[]
  reviews      Review[]
  waitingList  WaitingList[]
  unavailabilities Unavailability[]
  favorites    FavoriteDoctor[]
  appointmentsDraft AppointmentDraft[]
  auditLogs    AuditLog[]
  visitRecords VisitRecord[]
}

model Unavailability {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  endTime   DateTime
  reason    String   // Off, Surgery, Lunch, etc.
  doctorId  Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model WaitingList {
  id        Int      @id @default(autoincrement())
  date      DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId  Int
}

model Clinic {
  id        Int      @id @default(autoincrement())
  name      String
  city      String
  district  String
  
  doctors   Doctor[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes     String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  Int
  
  dependentId Int?
  dependent   Dependent? @relation(fields: [dependentId], references: [id])

  prescriptions Prescription[]
  reports       Report[]
  labResults    LabResult[]
  prescriptionItems PrescriptionItem[]
  visitRecord   VisitRecord?
}

model VisitRecord {
  id              Int      @id @default(autoincrement())
  appointmentId   Int      @unique
  doctorId        Int
  diagnosis       String
  examinationNote String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor          Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Report {
  id            Int      @id @default(autoincrement())
  title         String
  content       String   // Diagnosis, Prescription, etc.
  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime @default(now())
}

model Prescription {
  id            Int      @id @default(autoincrement())
  fileName      String   // Original file name
  filePath      String   // Path on server or S3 bucket URL
  notes         String?
  createdAt     DateTime @default(now())
  
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId Int
}

model TimeSlot {
  id           Int      @id @default(autoincrement())
  startTime    DateTime
  endTime      DateTime
  currentCount Int      @default(0)
  maxCapacity  Int      @default(2)
  
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  doctorId     Int
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  Int
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String   @default("INFO")
  isRead      Boolean  @default(false)
  metadata    String?
  createdAt   DateTime @default(now())
  readAt      DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
}

model HealthProfile {
  id                 Int      @id @default(autoincrement())
  bloodType          String?
  allergies          String?
  chronicConditions  String?
  medications        String?
  emergencyContact   String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int      @unique
}

model LabResult {
  id              Int      @id @default(autoincrement())
  testName        String
  resultValue     String
  unit            String?
  referenceRange  String?
  status          String   @default("NORMAL")
  notes           String?
  createdAt       DateTime @default(now())

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId   Int
}

model PrescriptionItem {
  id              Int      @id @default(autoincrement())
  medicineName    String
  dosage          String
  frequency       String
  durationDays    Int
  instructions    String?
  createdAt       DateTime @default(now())

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId   Int
}

model AppointmentDraft {
  id                 Int      @id @default(autoincrement())
  step               Int      @default(1)
  city               String?
  district           String?
  clinicId           Int?
  doctorId           Int?
  date               DateTime?
  timeSlotId         Int?
  dependentId        Int?
  notes              String?
  status             String   @default("IN_PROGRESS")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  doctor             Doctor?  @relation(fields: [doctorId], references: [id])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorRole     String?
  actorName     String?
  actorUserId   Int?
  action        String
  resource      String
  resourceId    String?
  details       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId      Int?
}
